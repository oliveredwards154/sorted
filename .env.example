# Copy this file to .env and fill in what you have. Everything is optional:
# the site runs with none of it, and each feature switches on when its setting is present.
# Never commit .env – it holds keys.

# --- Site ---
PORT=3000
SITE_URL=http://localhost:3000
CONTACT_EMAIL=hello@yourdomain.co.uk

# --- Photo recognition (Claude) ---
# Get a key at https://console.anthropic.com → API keys. Set a monthly spend limit there.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Affiliate networks: your publisher IDs (from each network's dashboard once you've joined) ---
AWIN_PUBLISHER_ID=
RAKUTEN_SITE_ID=
CJ_PUBLISHER_ID=
WEBGAINS_CAMPAIGN_ID=
# Optional catch-all while direct approvals come through:
SKIMLINKS_SITE_ID=

# --- Product feeds ---
# Awin: Toolbox > Create-a-Feed > copy the download URL. Several URLs: separate with spaces.
AWIN_FEED_URLS=
# Other networks: add an entry to data/feeds.json and put its URL in the env var it names, e.g.
# WEBGAINS_FEED_ALBAM=

# Where click logs, usage counts and email sign-ups are saved. On Railway, attach a volume at /data and set this to /data.
DATA_DIR=
# Password for /admin (usage counts and email sign-up list). Any username works. Leave blank to switch /admin off.
ADMIN_PASSWORD=

# Sovrn Commerce key (alternative to Skimlinks; if both are set, Skimlinks is used).
SOVRN_KEY=
# Who runs the site (privacy page). A sole trader needs only a name. Add the other two once you're a company.
OPERATOR_NAME=
COMPANY_NUMBER=
OPERATOR_ADDRESS=
# Ownership-check tags a network asks you to add to your site, as name=content pairs separated by |
# e.g. skimlinks-site-verification=abc123|google-site-verification=xyz
SITE_VERIFICATION=
